# Production API and OAuth requests use https://apif.omrudra.tech.
# Local API calls use the Vite proxy at /api/v1.
# Set VITE_API_SANDBOX=true to send local API calls to the in-memory sandbox.
# Set PROXY_SHARED_SECRET locally to authenticate Vite's backend proxy.
VITE_API_SANDBOX=false

VITE_MAX_FILE_SIZE_MB=1024
VITE_LARGE_FILE_THRESHOLD_MB=20
VITE_CHUNK_SIZE_MB=5
VITE_UPLOAD_CONCURRENCY=3
VITE_UPLOAD_MAX_RETRIES=3
