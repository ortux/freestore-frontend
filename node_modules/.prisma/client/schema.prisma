generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum SharePermission {
  VIEW
  EDIT
  MANAGE
}

enum FileStatus {
  PENDING
  UPLOADING
  ACTIVE
  DELETING
  DELETED
  FAILED
}

enum StorageType {
  GITHUB_SINGLE
  GITHUB_CHUNKED
}

enum UploadSessionStatus {
  INITIALIZED
  UPLOADING
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
  EXPIRED
}

enum ChunkStatus {
  UPLOADED
  FAILED
  DELETED
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id                         String   @id @default(uuid())
  githubId                   String   @unique @map("github_id")
  githubUsername             String   @map("github_username")
  email                      String?
  githubAccessTokenEncrypted String   @map("github_access_token_encrypted") @db.Text
  encryptedMasterKey         String   @map("encrypted_master_key") @db.Text
  repositoryName             String?  @map("repository_name")
  repositoryOwner            String?  @map("repository_owner")
  createdAt                  DateTime @default(now()) @map("created_at")
  updatedAt                  DateTime @updatedAt @map("updated_at")

  files                File[]
  apiKeys              ApiKey[]
  workspaceMemberships WorkspaceMember[]
  ownedWorkspaces      Workspace[]       @relation("WorkspaceOwner")
  sharedByMe           FileShare[]       @relation("SharedBy")
  sharedWithMe         FileShare[]       @relation("SharedWith")
  uploadSessions       UploadSession[]
  folders              Folder[]
  activities           FileActivity[]

  @@map("users")
}

model Workspace {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  ownerId     String   @map("owner_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  owner   User              @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  members WorkspaceMember[]
  files   File[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  userId      String   @map("user_id")
  role        Role     @default(MEMBER)
  invitedById String?  @map("invited_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

model File {
  id                String      @id
  userId            String      @map("user_id")
  workspaceId       String?     @map("workspace_id")
  folderId          String?     @map("folder_id")
  sortOrder         Int         @default(0) @map("sort_order")
  originalFilename  String      @map("original_filename")
  storedFilename    String      @map("stored_filename")
  storagePath       String      @map("storage_path")
  providerRef       String?     @map("provider_ref")
  mimeType          String      @map("mime_type")
  fileSize          Int         @map("file_size")
  encryptedFileKey  String      @map("encrypted_file_key") @db.Text
  encryptionVersion Int         @default(1) @map("encryption_version")
  storageType       StorageType @default(GITHUB_SINGLE) @map("storage_type")
  chunkSize         Int?        @map("chunk_size")
  totalChunks       Int?        @map("total_chunks")
  checksum          String
  status            FileStatus  @default(PENDING)
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace  Workspace?      @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  folder     Folder?         @relation(fields: [folderId], references: [id], onDelete: SetNull)
  shares     FileShare[]
  chunks     FileChunk[]
  uploads    UploadSession[]
  activities FileActivity[]
  publicLink PublicFileLink?

  @@index([userId])
  @@index([workspaceId])
  @@index([folderId, sortOrder])
  @@map("files")
}

model Folder {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  parentId  String?  @map("parent_id")
  name      String   @db.VarChar(255)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   Folder?  @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Folder[] @relation("FolderHierarchy")
  files    File[]

  @@index([userId, parentId, sortOrder])
  @@map("folders")
}

model FileActivity {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  fileId    String?  @map("file_id")
  action    String   @db.VarChar(32)
  fileName  String   @map("file_name") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  file File? @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([fileId])
  @@map("file_activities")
}

model PublicFileLink {
  id              String    @id @default(uuid())
  fileId          String    @unique @map("file_id")
  tokenHash       String    @unique @map("token_hash") @db.Char(64)
  tokenCiphertext String    @map("token_ciphertext") @db.Text
  expiresAt       DateTime? @map("expires_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  file File @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("public_file_links")
}

model FileChunk {
  id            String      @id @default(uuid())
  fileId        String      @map("file_id")
  chunkIndex    Int         @map("chunk_index")
  githubPath    String      @map("github_path")
  githubSha     String?     @map("github_sha")
  encryptedSize Int         @map("encrypted_size")
  originalSize  Int         @map("original_size")
  nonce         String
  checksum      String
  status        ChunkStatus @default(UPLOADED)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  file File @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([fileId, chunkIndex])
  @@index([fileId])
  @@map("file_chunks")
}

model UploadSession {
  id               String              @id @default(uuid())
  userId           String              @map("user_id")
  fileId           String              @map("file_id")
  originalFilename String              @map("original_filename")
  mimeType         String              @map("mime_type")
  fileSize         Int                 @map("file_size")
  chunkSize        Int                 @map("chunk_size")
  totalChunks      Int                 @map("total_chunks")
  status           UploadSessionStatus @default(INITIALIZED)
  expiresAt        DateTime            @map("expires_at")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  file File @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([expiresAt])
  @@map("upload_sessions")
}

model FileShare {
  id                        String          @id @default(uuid())
  fileId                    String          @map("file_id")
  sharedWithId              String          @map("shared_with_id")
  sharedById                String          @map("shared_by_id")
  permission                SharePermission @default(VIEW)
  recipientEncryptedFileKey String          @map("recipient_encrypted_file_key") @db.Text
  expiresAt                 DateTime?       @map("expires_at")
  createdAt                 DateTime        @default(now()) @map("created_at")
  updatedAt                 DateTime        @updatedAt @map("updated_at")

  file       File @relation(fields: [fileId], references: [id], onDelete: Cascade)
  sharedWith User @relation("SharedWith", fields: [sharedWithId], references: [id], onDelete: Cascade)
  sharedBy   User @relation("SharedBy", fields: [sharedById], references: [id], onDelete: Cascade)

  @@unique([fileId, sharedWithId])
  @@index([sharedWithId])
  @@map("file_shares")
}

model ApiKey {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  name      String
  keyHash   String    @unique @map("key_hash")
  prefix    String
  lastUsed  DateTime? @map("last_used")
  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime? @map("expires_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("api_keys")
}
